# Variáveis do back-end. No PC, copie para ".env" e preencha; no Railway,
# cadastre-as em Variables. NUNCA coloque valores reais neste arquivo.

# Chave da API da Anthropic (chat com a IA).
ANTHROPIC_API_KEY=

# Assinatura dos tokens de login: texto aleatório com 32+ caracteres.
# Use um valor diferente em cada ambiente (PC e Railway).
JWT_SECRET=

# Banco PostgreSQL. No Railway, referencie as variáveis do serviço do banco
# (ex.: PGHOST=${{Postgres.PGHOST}}). No PC, os padrões apontam para
# localhost:5432/cuidamed_db com usuário postgres — só a senha é obrigatória.
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=

# Sites que podem chamar a API pelo navegador, separados por vírgula
# (ex.: https://cuidamed-web.up.railway.app). Padrão: os endereços locais.
CORS_ORIGENS=

# Opcionais: porta (o Railway define sozinho) e log de SQL (true para depurar).
PORT=
MOSTRAR_SQL=

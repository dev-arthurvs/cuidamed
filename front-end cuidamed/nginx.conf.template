# Configuração do nginx que serve o site (o ${PORT} é trocado ao iniciar).
server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    # Compacta texto antes de enviar (páginas carregam mais rápido).
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Arquivos de /assets têm o conteúdo no nome (ex.: index-CcYT4wcN.js): o
    # navegador pode guardá-los por um ano sem perguntar de novo.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Rotas do app (/painel, /agenda...): sempre devolvem o index.html, e o
    # React decide a tela. Sem cache, para cada nova versão chegar na hora.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }
}
